ip address add 10.1.2.2/24 dev eth0
ip address add 10.1.1.1/24 dev eth1
ip link set eth0 up
ip link set eth1 up
ip route replace default via 10.1.2.1
sysctl -w net.ipv4.ip_forward=1
chmod 0755 /usr/local/sbin/set-access-link.sh

# Default 4G-like uplink. Downlink shaping is on ISP 2's access egress.
/usr/local/sbin/set-access-link.sh eth0 5mbit 25ms 0.2%
