ip address add 10.0.4.1/24 dev eth0
ip address add 10.0.3.2/24 dev eth1
ip link set eth0 up
ip link set eth1 up
ip route add 10.0.1.0/24 via 10.0.3.1

# Small fixed backbone propagation delay; access-profile delay is added later.
tc qdisc replace dev eth1 root netem delay 2ms

# Preserve the Docker bridge as the return path for localhost:8081 only.
bridge_ip="$(ip -o -4 address show dev eth2 | awk '{print $4}' | cut -d/ -f1)"
bridge_gateway="${bridge_ip%.*}.1"
ip route replace default via "$bridge_gateway" dev eth2 table 100
ip rule add from "$bridge_ip/32" table 100

nginx
iperf3 --server --daemon --port 5201 --pidfile /run/iperf3-download.pid --logfile /var/log/iperf3-download.log
iperf3 --server --daemon --port 5202 --pidfile /run/iperf3-upload.pid --logfile /var/log/iperf3-upload.log
